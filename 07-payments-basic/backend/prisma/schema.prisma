// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id    String  @id @default(cuid())
  name  String
  email String  @unique
  phone String?

  // Relations
  invoices Invoice[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id          String @id @default(cuid())
  name        String
  description String?
  unitPrice   Float  // in paise/cents

  // Relations
  invoiceLines InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id       String  @id @default(cuid())
  number   String  @unique
  status   String  @default("draft") // draft, issued, partially_paid, paid, cancelled

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  subtotal  Float  @default(0)
  taxAmount Float  @default(0)
  total     Float  @default(0)

  // Payment tracking
  paidAmount Float  @default(0)
  balanceDue Float  @default(0)

  // Relations
  invoiceLines InvoiceLine[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceLine {
  id        String @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  quantity  Float
  unitPrice Float
  lineTotal Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([itemId])
}

model Payment {
  id       String  @id @default(cuid())
  publicId String  @unique // User-facing ID for public status page
  status   String  @default("created") // created, pending, captured, failed, cancelled

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  amount Float // Amount to be paid in paise/cents

  // Provider info
  providerPaymentId String? // Mock provider ID or Razorpay ID
  providerName      String  @default("mock") // 'mock', 'razorpay', etc

  // Idempotency tracking
  lastEventId String? // Last processed provider event ID

  // Relations
  paymentEvents PaymentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
}

model PaymentEvent {
  id        String @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  eventId    String  @unique // External provider event ID
  eventType  String  // 'payment.created', 'payment.succeeded', 'payment.failed'
  status     String  // Event processing status
  payload    String  // JSON string of event payload
  processed  Boolean @default(false)
  error      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
}
