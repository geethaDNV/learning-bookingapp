# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Email Configuration ───────────────────────────────────────────────────────
# Set to "mock" for local development or "resend" for real email provider
EMAIL_PROVIDER="mock"

# Only required if EMAIL_PROVIDER="resend"
RESEND_API_KEY="your_resend_api_key_here"

# Email sender address (used for both mock and Resend)
EMAIL_FROM="noreply@invoicedemo.local"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
