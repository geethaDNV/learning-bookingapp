# Copy this file to .env and fill in your own Neon connection string.
# Create a free Neon project at https://neon.tech, then create a branch
# dedicated to this module (e.g. "01-items-basic") and copy its connection string here.
DATABASE_URL="postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require"

PORT=4001
