# Database
DATABASE_URL=postgresql://user:password@localhost:5432/learning_08_payments_razorpay

# Port
PORT=3001

# Razorpay Keys (from https://dashboard.razorpay.com/settings/api-keys)
# Sandbox/Test mode:
#   - KEY_ID: Test key ID (starts with rzp_test_)
#   - KEY_SECRET: Test key secret
#   - WEBHOOK_SECRET: From https://dashboard.razorpay.com/settings/webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public URL for payment callbacks (use ngrok/Cloudflare tunnel for local testing)
# Example: https://abcd1234.ngrok.io
APP_PUBLIC_URL=http://localhost:3001

# Provider selection: "razorpay" or "mock"
PAYMENT_PROVIDER=mock
