{
  "name": "bookkeeping-payments-accounting-advanced-backend",
  "version": "1.0.0",
  "description": "Backend for payments accounting advanced learning module",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=25 <26"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "express": "^4.18.2",
    "zod": "^3.22.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/cors": "^2.8.17",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "prisma": "^5.14.0"
  }
}
